# not a huge fan of "Winter", "Cascades", "Mushroom", "Sunset2", and "Anemone"
# LOVE "Starfish", "Shuksan", "Sunset", "Moth", "Sailboat", "Spring"
# this leaves "Bay", "Winter", "Lake", "Shuksan2"
starfishPal = pnw_palette("Starfish", n = 6, type = "discrete")  # n is how many colours
shuksanPal = pnw_palette("Shuksan", n = 6, type = "discrete")
sunsetPal = pnw_palette("Sunset", n = 6, type = "discrete")
mothPal = pnw_palette("Moth", n = 6, type = "continuous")
sailboatPal = pnw_palette("Sailboat", n = 6, type = "discrete")
springPal = pnw_palette("Spring", n = 6, type = "discrete")
bayPal = pnw_palette("Bay", n = 3, type = "discrete") # for vaccinated (only 3 compartments)
