exposedPlotting <- results[[2]]
infectedPlotting <- results[[3]]
hospitalisedPlotting <- results[[4]]
recoveredPlotting <- results[[5]]
deadPlotting <- results[[6]]
vaccinatedPlotting <- results[[7]]
